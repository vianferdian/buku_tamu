datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SECURITY
}

enum VisitStatus {
  NEW
  CONTACTED
  COMPLETED
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  name       String
  role       Role     @default(SECURITY)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relationships
  contactedVisits Visit[] @relation("ContactedBy")
  completedVisits Visit[] @relation("CompletedBy")
  activityLogs    ActivityLog[]

  @@map("users")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  employees Employee[]
  visits    Visit[]

  @@map("departments")
}

model Employee {
  id           Int        @id @default(autoincrement())
  name         String
  nip          String?
  position     String
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  expertise    String?    // e.g., Konsentrasi Keahlian PPLG
  phone        String     // Stored in standard format, e.g. 628123456789
  email        String?
  isActive     Boolean    @default(true) @map("is_active")
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relationships
  visits Visit[]

  @@map("employees")
}

model VisitorType {
  id        Int      @id @default(autoincrement())
  name      String   // e.g., Orang Tua / Wali, Instansi, Dunia Kerja / Industri
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  purposes VisitPurpose[]
  visits   Visit[]

  @@map("visitor_types")
}

model VisitPurpose {
  id            Int         @id @default(autoincrement())
  visitorTypeId Int         @map("visitor_type_id")
  visitorType   VisitorType @relation(fields: [visitorTypeId], references: [id], onDelete: Cascade)
  name          String      // e.g., Bertemu Wali Kelas, Kerja Sama
  isActive      Boolean     @default(true) @map("is_active")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relationships
  visits Visit[]

  @@map("visit_purposes")
}

model Visit {
  id                 Int         @id @default(autoincrement())
  visitCode          String      @unique @map("visit_code")
  visitorName        String      @map("visitor_name")
  visitorPhone       String      @map("visitor_phone")
  visitorTypeId      Int         @map("visitor_type_id")
  visitorType        VisitorType @relation(fields: [visitorTypeId], references: [id])
  institutionName    String?     @map("institution_name")
  visitorAddress     String?     @map("visitor_address")
  studentName        String?     @map("student_name")
  studentClass       String?     @map("student_class")
  destinationId      Int         @map("destination_id") // department_id
  department         Department  @relation(fields: [destinationId], references: [id])
  employeeId         Int         @map("employee_id")
  employee           Employee    @relation(fields: [employeeId], references: [id])
  purposeId          Int         @map("purpose_id")
  purpose            VisitPurpose @relation(fields: [purposeId], references: [id])
  purposeDescription String?     @db.Text @map("purpose_description")
  guestCount         Int         @default(1) @map("guest_count")
  status             VisitStatus @default(NEW)
  visitedAt          DateTime    @default(now()) @map("visited_at")
  
  contactedAt        DateTime?   @map("contacted_at")
  contactedById      Int?        @map("contacted_by_id")
  contactedBy        User?       @relation("ContactedBy", fields: [contactedById], references: [id])

  completedAt        DateTime?   @map("completed_at")
  completedById      Int?        @map("completed_by_id")
  completedBy        User?       @relation("CompletedBy", fields: [completedById], references: [id])

  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("visits")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  description String   @db.Text
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}
